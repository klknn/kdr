{
    "buildTypes":
    {
        "unittest-opt":
        {
            "buildOptions": ["unittests", "optimize", "inline"]
        },
        "unittest-native":
        {
            "buildOptions": ["unittests", "optimize", "inline"],
            "dflags-ldc": ["-mcpu=native"]
        },
        "release-native":
        {
            "buildOptions": ["releaseMode", "optimize", "inline", "noBoundsCheck"],
            "dflags-ldc": ["-mcpu=native"]
        }
    },
    "dependencies": {
        "dplug:flat-widgets": "~>13.0",
        "dplug:pbr-widgets": "~>13.0",
        "mir-core": "~>1.3"
    },
    "name": "kdr",
    "stringImportPaths": [
        "resource"
    ],
    "configurations": [
        {
            "name": "library",
            "targetType": "library"
        },
        {
            "name": "unittest",
            "targetType": "library",
            "sourcePaths": ["source", "tests"],
            "importPaths": ["source", "tests"]
        }
    ]
}
